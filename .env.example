APP_ENV=development
APP_NAME=AlphaAI
API_HOST=0.0.0.0
API_PORT=8000

POSTGRES_DB=alphaai
POSTGRES_USER=alphaai
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
DATABASE_URL=postgresql+psycopg://alphaai:replace-with-a-long-random-local-password@postgres:5432/alphaai
REDIS_URL=redis://redis:6379/0

# Optional provider credentials. Keep real values in local .env or a secret manager.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GOOGLE_API_KEY=
HUGGINGFACE_TOKEN=

# Generate a unique random value of at least 32 characters.
ALPHAAI_SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=30
