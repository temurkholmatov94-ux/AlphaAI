APP_ENV=development
APP_NAME=AlphaAI
API_HOST=0.0.0.0
API_PORT=8000

POSTGRES_DB=alphaai
POSTGRES_USER=alphaai
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
DATABASE_URL=postgresql+psycopg://alphaai:replace-with-a-long-random-local-password@postgres:5432/alphaai
REDIS_URL=redis://redis:6379/0

# Optional provider credentials. Keep real values in local .env or a secret manager.
# Never commit real keys to GitHub or expose them in browser code.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
HUGGINGFACE_TOKEN=

# JSON array. Public alias=provider:upstream-model.
# Routes only become available when the matching provider credential is configured.
ALPHAAI_MODEL_ROUTES=[]
# Comma-separated or JSON list of platform administrator email addresses.
ALPHAAI_ADMIN_EMAILS=[]

# Generate a unique random value of at least 32 characters.
ALPHAAI_SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=30
